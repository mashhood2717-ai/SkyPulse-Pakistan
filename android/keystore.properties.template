# Keystore configuration for release builds
# Fill in your values and place this file in android/ directory
# 
# IMPORTANT: Add keystore.properties to .gitignore to avoid exposing sensitive data!
# In android/.gitignore, add: keystore.properties

# Path to your keystore file (relative to android/ directory or absolute path)
store.file=../app.keystore

# Password for the keystore
store.password=YOUR_KEYSTORE_PASSWORD

# Alias of the key to use
key.alias=app-key

# Password for the key
key.password=YOUR_KEY_PASSWORD
